rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSiteAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches('(?i)^kennywemson1@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^osenialayo@gmail\\.com$')
        );
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['siteName'])
        && data.keys().hasOnly([
          'siteName', 'logoUrl', 'heroBgUrl', 'heroTitle', 'heroSubtitle',
          'aboutBgUrl', 'aboutFacts', 'servicesBgUrl', 'blogBgUrl',
          'ceoPhotoUrl', 'copyrightText'
        ])
        && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 120
        && isOptionalString(data, 'logoUrl', 2000)
        && isOptionalString(data, 'heroBgUrl', 2000)
        && isOptionalString(data, 'heroTitle', 300)
        && isOptionalString(data, 'heroSubtitle', 600)
        && isOptionalString(data, 'aboutBgUrl', 2000)
        && isOptionalString(data, 'servicesBgUrl', 2000)
        && isOptionalString(data, 'blogBgUrl', 2000)
        && isOptionalString(data, 'ceoPhotoUrl', 2000)
        && isOptionalString(data, 'copyrightText', 300)
        && (!('aboutFacts' in data) || (data.aboutFacts is list && data.aboutFacts.size() <= 12));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'shortDescription', 'position'])
        && data.keys().hasOnly([
          'name', 'category', 'brand', 'subCategory', 'price', 'salePrice', 'stock', 'imageUrl',
          'shortDescription', 'position', 'variations'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && isOptionalString(data, 'category', 120)
        && isOptionalString(data, 'brand', 120)
        && isOptionalString(data, 'subCategory', 120)
        && data.shortDescription is string && data.shortDescription.size() <= 2000
        && data.position is number
        && isOptionalString(data, 'price', 60)
        && isOptionalString(data, 'salePrice', 60)
        && isOptionalString(data, 'imageUrl', 2000)
        && (!('stock' in data) || data.stock is number)
        && (!('variations' in data) || (data.variations is list && data.variations.size() <= 25));
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'description', 'icon', 'position'])
        && data.keys().hasOnly(['title', 'description', 'icon', 'image', 'features', 'position'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 60
        && data.position is number
        && isOptionalString(data, 'image', 2000)
        && (!('features' in data) || (data.features is list && data.features.size() <= 20));
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author', 'price', 'status', 'position'])
        && data.keys().hasOnly(['title', 'author', 'price', 'status', 'coverImage', 'preface', 'position'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 150
        && data.price is string && data.price.size() >= 1 && data.price.size() <= 60
        && data.status in ['Draft', 'Published']
        && data.position is number
        && isOptionalString(data, 'coverImage', 2000)
        && isOptionalString(data, 'preface', 10000);
    }

    function isValidEditorial(data) {
      return data.keys().hasAll(['title', 'slug', 'status', 'category', 'date', 'position'])
        && data.keys().hasOnly([
          'title', 'slug', 'excerpt', 'content', 'category', 'author',
          'date', 'image', 'status', 'featured', 'metaTitle', 'metaDescription',
          'focusKeywords', 'position', 'createdAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 250
        && data.status in ['Draft', 'Published']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 120
        && data.date is string && data.date.size() >= 6 && data.date.size() <= 30
        && data.position is number
        && isOptionalString(data, 'excerpt', 1000)
        && isOptionalString(data, 'content', 100000)
        && isOptionalString(data, 'author', 120)
        && isOptionalString(data, 'image', 2000)
        && isOptionalString(data, 'metaTitle', 200)
        && isOptionalString(data, 'metaDescription', 500)
        && isOptionalString(data, 'focusKeywords', 300)
        && (!('featured' in data) || data.featured is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['text', 'author', 'location', 'position'])
        && data.keys().hasOnly(['text', 'author', 'location', 'position'])
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 150
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 150
        && data.position is number;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'service', 'date', 'time', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'service', 'date', 'time', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data['service'] is string && data['service'].size() >= 1 && data['service'].size() <= 200
        && data.date is string && data.date.size() >= 6 && data.date.size() <= 30
        && data.time is string && data.time.size() >= 3 && data.time.size() <= 30
        && data.status in ['Pending', 'Confirmed', 'Completed', 'Cancelled']
        && data.createdAt is timestamp
        && isOptionalString(data, 'message', 2000);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'date', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'date', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 250
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.status in ['Unread', 'Read']
        && data.date is string && data.date.size() >= 6 && data.date.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'name', 'product', 'total', 'status', 'date'])
        && data.keys().hasOnly(['orderId', 'name', 'product', 'total', 'status', 'date', 'createdAt'])
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 60
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.product is string && data.product.size() >= 1 && data.product.size() <= 300
        && data.total is string && data.total.size() >= 1 && data.total.size() <= 60
        && data.status in ['Processing', 'Shipped', 'Delivered']
        && data.date is string && data.date.size() >= 6 && data.date.size() <= 30
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidComment(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'userName', 'text', 'createdAt', 'status'])
        && data.keys().hasOnly(['userId', 'userEmail', 'userName', 'userPhoto', 'text', 'createdAt', 'status'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 150
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 3000
        && data.createdAt is timestamp
        && data.status in ['pending', 'approved']
        && isOptionalString(data, 'userPhoto', 2000);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'displayName'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role in ['admin', 'client']
        && isOptionalString(data, 'displayName', 150);
    }

    function isCommentParentCollection(col) {
      return col in ['editorial', 'products', 'services'];
    }

    match /sites/{siteId} {
      // Public Content Collections
      match /settings/{settingId} {
        allow get: if isValidId(siteId) && isValidId(settingId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(settingId) && isSiteAdmin() && isValidSettings(incoming());
        allow delete: if isValidId(siteId) && isValidId(settingId) && isSiteAdmin();
      }

      match /products/{productId} {
        allow get: if isValidId(siteId) && isValidId(productId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(productId) && isSiteAdmin() && isValidProduct(incoming());
        allow delete: if isValidId(siteId) && isValidId(productId) && isSiteAdmin();
      }

      match /services/{serviceId} {
        allow get: if isValidId(siteId) && isValidId(serviceId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(serviceId) && isSiteAdmin() && isValidService(incoming());
        allow delete: if isValidId(siteId) && isValidId(serviceId) && isSiteAdmin();
      }

      match /books/{bookId} {
        allow get: if isValidId(siteId) && isValidId(bookId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(bookId) && isSiteAdmin() && isValidBook(incoming());
        allow delete: if isValidId(siteId) && isValidId(bookId) && isSiteAdmin();
      }

      match /editorial/{articleId} {
        allow get: if isValidId(siteId) && isValidId(articleId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(articleId) && isSiteAdmin() && isValidEditorial(incoming());
        allow delete: if isValidId(siteId) && isValidId(articleId) && isSiteAdmin();
      }

      match /testimonials/{testimonialId} {
        allow get: if isValidId(siteId) && isValidId(testimonialId);
        allow list: if isValidId(siteId);
        allow create, update: if isValidId(siteId) && isValidId(testimonialId) && isSiteAdmin() && isValidTestimonial(incoming());
        allow delete: if isValidId(siteId) && isValidId(testimonialId) && isSiteAdmin();
      }

      // Private PII Submissions
      match /appointments/{appointmentId} {
        allow get: if isValidId(siteId) && isValidId(appointmentId) && isSiteAdmin();
        allow list: if isValidId(siteId) && isSiteAdmin();
        allow create: if isValidId(siteId) && isValidId(appointmentId)
          && isValidAppointment(incoming())
          && incoming().createdAt == request.time
          && (isSiteAdmin() || incoming().status == 'Pending');
        allow update: if isValidId(siteId) && isValidId(appointmentId)
          && isSiteAdmin()
          && isValidAppointment(incoming())
          && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(siteId) && isValidId(appointmentId) && isSiteAdmin();
      }

      match /messages/{messageId} {
        allow get: if isValidId(siteId) && isValidId(messageId) && isSiteAdmin();
        allow list: if isValidId(siteId) && isSiteAdmin();
        allow create: if isValidId(siteId) && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().createdAt == request.time
          && (isSiteAdmin() || incoming().status == 'Unread');
        allow update: if isValidId(siteId) && isValidId(messageId)
          && isSiteAdmin()
          && isValidMessage(incoming())
          && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(siteId) && isValidId(messageId) && isSiteAdmin();
      }

      match /orders/{orderId} {
        allow get: if isValidId(siteId) && isValidId(orderId) && isSiteAdmin();
        allow list: if isValidId(siteId) && isSiteAdmin();
        allow create, update: if isValidId(siteId) && isValidId(orderId) && isSiteAdmin() && isValidOrder(incoming());
        allow delete: if isValidId(siteId) && isValidId(orderId) && isSiteAdmin();
      }

      // Moderated Comments & Replies on editorial, products, services
      match /{col}/{docId}/comments/{commentId} {
        allow get: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId)
          && (existing().status == 'approved' || isSiteAdmin());
        allow list: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId)
          && (resource.data.status == 'approved' || isSiteAdmin());
        allow create: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId)
          && isAuthenticated()
          && isValidComment(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && (isSiteAdmin() || incoming().status == 'pending');
        allow update: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId)
          && isSiteAdmin()
          && isValidComment(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId)
          && isAuthenticated()
          && (request.auth.uid == existing().userId || isSiteAdmin());

        match /replies/{replyId} {
          allow get: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId) && isValidId(replyId)
            && (existing().status == 'approved' || isSiteAdmin());
          allow list: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId)
            && (resource.data.status == 'approved' || isSiteAdmin());
          allow create: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId) && isValidId(replyId)
            && isAuthenticated()
            && isValidComment(incoming())
            && incoming().userId == request.auth.uid
            && incoming().createdAt == request.time
            && (isSiteAdmin() || incoming().status == 'pending');
          allow update: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId) && isValidId(replyId)
            && isSiteAdmin()
            && isValidComment(incoming())
            && incoming().userId == existing().userId
            && incoming().createdAt == existing().createdAt;
          allow delete: if isValidId(siteId) && isCommentParentCollection(col) && isValidId(docId) && isValidId(commentId) && isValidId(replyId)
            && isAuthenticated()
            && (request.auth.uid == existing().userId || isSiteAdmin());
        }
      }
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSiteAdmin());
      allow list: if isSiteAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (isSiteAdmin() || incoming().role == 'client');
      allow update: if isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && (
          isSiteAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']))
        );
      allow delete: if isValidId(userId) && isSiteAdmin();
    }
  }
}
